[Unit]
Description=One-shot isolated STS2 public event-effect integration smoke
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sts2-event-effect-stage-20260918/sts2-solver-bridge
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/ubuntu/sts2-event-effect-stage-20260918/sts2-solver-bridge/run_event_effect_smoke.py run
TimeoutStartSec=infinity
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
MemoryMax=3000M
CPUQuota=300%
TasksMax=160
StandardOutput=journal
StandardError=journal

