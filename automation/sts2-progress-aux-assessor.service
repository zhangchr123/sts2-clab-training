[Unit]
Description=Independently verify and archive the progress-aux paired evaluation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sts2-cloud-eval/progress-aux
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/ubuntu/sts2-cloud-eval/progress-aux/assessment/assess_progress_aux_eval.py
Restart=on-failure
RestartSec=60
MemoryMax=768M
TimeoutStartSec=infinity
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
