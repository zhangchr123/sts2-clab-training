[Unit]
Description=Switch continuous sampling to paired evaluation at a clean batch boundary
After=network-online.target sts2-cloud-goal.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/sts2-cloud-eval/progress-aux
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/ubuntu/sts2-cloud-eval/progress-aux/input/handoff_to_progress_aux_eval.py
Restart=on-failure
RestartSec=30
MemoryMax=128M
TimeoutStartSec=infinity
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
